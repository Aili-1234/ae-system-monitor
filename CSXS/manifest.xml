<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0" ExtensionBundleId="com.sysmon.ae.panel"
                   ExtensionBundleVersion="1.7.10" ExtensionBundleName="AE System Monitor"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <ExtensionList>
    <Extension Id="com.sysmon.ae.panel.main" Version="1.7.10" />
  </ExtensionList>

  <ExecutionEnvironment>
    <HostList>
      <!-- AEFT = After Effects。
           18.0 = AE 2021（CEP 11 / Chromium 88），往上到 99.9 覆盖所有未来版本。
           下界由界面真正依赖的内核特性决定，不是保守取值：小窗自适应用了
           flex gap（Chromium 84+）、clamp()/min()/max()（79+）、inset（87+）。
           AE 2018~2020 是 Chromium 61~74：面板能加载，但间距全丢、缩放失效，
           所以不再声明——宁可少支持三个版本，也不让用户装上一个排版塌掉的面板。
           代码里的老 Node 降级分支（无 fs.promises / 无 withFileTypes）仍保留。 -->
      <Host Name="AEFT" Version="[15.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <!-- 面板依赖 Node（内置的 require），且界面用了 CEP 11 的 Chromium 88 内核特性 -->
      <RequiredRuntime Name="CSXS" Version="8.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>

  <DispatchInfoList>
    <Extension Id="com.sysmon.ae.panel.main">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./jsx/host.jsx</ScriptPath>
          <CEFCommandLine>
            <!-- 开启 Node.js：读内存 / 磁盘 / 文件大小全靠它 -->
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>

        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>

        <UI>
          <Type>Panel</Type>
          <Menu>System Monitor</Menu>
          <Geometry>
            <Size>
              <Height>660</Height>
              <Width>340</Width>
            </Size>
            <MinSize>
              <Height>132</Height>
              <Width>96</Width>
            </MinSize>
            <MaxSize>
              <Height>2400</Height>
              <Width>2000</Width>
            </MaxSize>
          </Geometry>
          <Icons />
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
